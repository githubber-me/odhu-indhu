# Server-only provider credentials. Never expose these to the browser.
SARVAM_API_KEY=
PARALLEL_API_KEY=
SARVAM_MODEL=sarvam-105b

# Required: Neon connection, managed Auth endpoint, and a random Vercel Cron secret.
DATABASE_URL=
NEON_AUTH_BASE_URL=
CRON_SECRET=

# Optional. If omitted, a domain-separated cookie key is derived from CRON_SECRET.
NEON_AUTH_COOKIE_SECRET=
