# Server-only provider credentials. Never expose these to the browser.
SARVAM_API_KEY=
PARALLEL_API_KEY=
SARVAM_MODEL=sarvam-105b

# Required: Neon connection, managed Auth endpoint, and a random Vercel Cron secret.
DATABASE_URL=
# With the Vercel integration's DATABASE prefix, this is created automatically
# as DATABASE_NEON_AUTH_BASE_URL. Either variable name is accepted.
NEON_AUTH_BASE_URL=
CRON_SECRET=

# Required for private weekly voice-note storage. Connecting a private Vercel
# Blob store to the project creates this value automatically.
BLOB_READ_WRITE_TOKEN=

# Optional. If omitted, a domain-separated cookie key is derived from CRON_SECRET.
NEON_AUTH_COOKIE_SECRET=
